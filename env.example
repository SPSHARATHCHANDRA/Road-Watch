# Copy this file to .env.local and fill in your own values.
# Leave both empty to run ROADWATCH in DEMO MODE (data saved only in your browser).
#
# Find these in Supabase: Project Settings -> API.
# Only use the "anon"/"publishable" key here. NEVER put the service_role key in a VITE_ variable —
# everything prefixed with VITE_ is bundled into the public frontend.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
